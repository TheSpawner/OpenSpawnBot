#!/bin/bash
set -o pipefail

APP="/Applications/OpenSpawn Bot.app"
PKG_ID="ai.openspawn.bot"
DATA_LEAF="Library/Application Support/OpenSpawn Bot"
WORK_LEAF="Documents/OpenSpawn Bot"

RED=""
BOLD=""
PLAIN=""
if [ -t 1 ]; then
  RED="$(printf '\033[31m')"
  BOLD="$(printf '\033[1m')"
  PLAIN="$(printf '\033[0m')"
fi

usage() {
  echo "Usage: sudo openspawn-bot-uninstall [--purge]"
  echo "  no flag   remove the app, its engine, model and search engine; keep chats and settings"
  echo "  --purge   also delete chats and settings"
}

MODE=""
case "${1:-}" in
  "") ;;
  --purge) MODE="purge" ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 1 ;;
esac

if [ "$(id -u)" != "0" ]; then
  echo "This uninstaller needs root. Run it with: sudo openspawn-bot-uninstall${MODE:+ --purge}" >&2
  exit 1
fi

homes() {
  for home in /Users/* /var/root; do
    [ -d "$home" ] || continue
    case "$home" in /Users/Shared|/Users/Guest) continue ;; esac
    echo "$home"
  done
}

found=0
[ -d "$APP" ] && found=1
while IFS= read -r home; do [ -d "$home/$DATA_LEAF" ] && found=1; done < <(homes)
if [ "$found" = "0" ]; then
  echo "OpenSpawn Bot is not installed on this Mac. Nothing to do."
  rm -f /usr/local/bin/openspawn-bot-uninstall
  exit 0
fi

TARGET_HOME="$HOME"
if [ -n "$SUDO_USER" ]; then
  TARGET_HOME="$(dscl . -read "/Users/$SUDO_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
  [ -n "$TARGET_HOME" ] || TARGET_HOME="/Users/$SUDO_USER"
fi
DATA="$TARGET_HOME/$DATA_LEAF"
WORK="$TARGET_HOME/$WORK_LEAF"

size_of() { if [ -d "$1" ]; then du -sh "$1" 2>/dev/null | cut -f1; else echo "-"; fi; }

confirm_purge() {
  if [ ! -t 0 ]; then
    echo "Deleting chats and settings needs confirmation. Run this in a terminal: sudo openspawn-bot-uninstall --purge" >&2
    exit 1
  fi
  printf '\n%sThis permanently deletes every chat and setting of OpenSpawn Bot%s\n' "$RED" "$PLAIN"
  printf '%sfor every account on this Mac. It cannot be undone.%s\n\n' "$RED" "$PLAIN"
  printf 'Type DELETE to confirm: '
  read -r confirmation
  if [ "$confirmation" != "DELETE" ]; then
    echo "Not confirmed. Nothing was removed."
    exit 1
  fi
}

printf '\n%sOpenSpawn Bot uninstaller%s\n\n' "$BOLD" "$PLAIN"
echo "On this account:"
printf '  %-60s %s\n' "$DATA" "$(size_of "$DATA")"
printf '  %-60s %s\n' "$DATA/runtime" "$(size_of "$DATA/runtime")"
echo

if [ "$MODE" = "purge" ]; then
  confirm_purge
elif [ -t 0 ]; then
  echo "  1) Remove the app, its engine, model and search engine. Keep my chats and settings."
  printf '  2) %sRemove everything.%s Also deletes my chats and settings.\n' "$RED" "$PLAIN"
  echo "  3) Cancel."
  echo
  printf 'Choose [1/2/3]: '
  read -r choice
  case "$choice" in
    1) MODE="remove" ;;
    2) confirm_purge; MODE="purge" ;;
    *) echo "Cancelled. Nothing was removed."; exit 0 ;;
  esac
else
  MODE="remove"
fi

echo
echo "Stopping OpenSpawn Bot"
stop_all() {
  pkill "-$1" -f "$APP/Contents/" >/dev/null 2>&1
  pkill "-$1" -f "/$DATA_LEAF/runtime/" >/dev/null 2>&1
  pkill "-$1" -f "/$DATA_LEAF/browser-profiles" >/dev/null 2>&1
}
stop_all TERM
sleep 2
stop_all KILL

echo "Removing the app"
rm -rf "$APP"
pkgutil --forget "$PKG_ID" >/dev/null 2>&1 || true

while IFS= read -r home; do
  if [ "$MODE" = "purge" ]; then
    if [ -d "$home/$DATA_LEAF" ]; then
      echo "Removing $home/$DATA_LEAF"
      rm -rf "$home/$DATA_LEAF"
    fi
    rm -rf "$home/Library/Caches/$PKG_ID" "$home/Library/HTTPStorages/$PKG_ID" \
      "$home/Library/Preferences/$PKG_ID.plist" "$home/Library/Saved Application State/$PKG_ID.savedState"
  elif [ -d "$home/$DATA_LEAF/runtime" ]; then
    echo "Removing the engine, model and search engine in $home/$DATA_LEAF/runtime"
    rm -rf "$home/$DATA_LEAF/runtime"
  fi
done < <(homes)

echo
if [ "$MODE" = "purge" ]; then
  echo "OpenSpawn Bot and all of its data have been removed."
else
  echo "OpenSpawn Bot was removed. Your chats and settings were kept in $DATA"
  echo "To delete them too, run: sudo openspawn-bot-uninstall --purge"
fi
if [ -d "$WORK" ]; then
  echo "The files OpenSpawn Bot saved for you were kept in $WORK"
fi

rm -f /usr/local/bin/openspawn-bot-uninstall
exit 0
